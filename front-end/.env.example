# OpenRouter API Configuration (provides access to GPT-4 and other models)
# Get your API key from: https://openrouter.ai/keys
VITE_OPENROUTER_API_KEY=your_openrouter_api_key_here
VITE_OPENROUTER_API_BASE_URL=https://openrouter.ai/api/v1
VITE_SITE_URL=http://localhost:5173
VITE_SITE_NAME=BuildYourBody

# YouTube API Configuration (optional for training videos)
VITE_YOUTUBE_API_KEY=your_youtube_api_key_here
